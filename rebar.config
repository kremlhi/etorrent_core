{erl_opts, [
            %% bin_opt_info,
            warn_format,
            warn_export_all,
            warn_export_vars,
            warn_obsolete_guard,
            warn_unused_import,
            warn_bif_clash,
            %% warn_missing_spec,
            warn_untyped_record,
            {parse_transform, lager_transform}]}.

{cover_enabled, true}.

{edoc_opts, [{todo, true}]}.

{eunit_opts, [{report,{eunit_surefire,[{dir,"."}]}}, verbose]}.

{profiles, [
    {test, [
        {extra_src_dirs, ["test/eunit"]},
        {eunit_tests, [
            {module, etorrent_utils_tests},
            {module, etorrent_mktorrent_tests},
            {module, etorrent_rlimit_tests},
            {module, etorrent_magnet_tests},
            {module, etorrent_http_uri_tests}
        ]}
    ]}
]}.

{deps, [
    {gproc,   {git, "https://github.com/uwiger/gproc.git",          {branch, "master"}}},
    {lager,   {git, "https://github.com/erlang-lager/lager.git",    {branch, "master"}}},
    {hackney, {git, "https://github.com/benoitc/hackney.git",       {branch, "master"}}},
    {meck,    {git, "https://github.com/eproxus/meck.git",          {branch, "master"}}},
    {proper,  {git, "https://github.com/proper-testing/proper.git", {branch, "master"}}},
    {cowboy,  {git, "https://github.com/ninenines/cowboy.git",      {branch, "master"}}},
    {ranch,   {git, "https://github.com/ninenines/ranch.git",       {branch, "master"}}}  %% cowboy 2.x needs this explicitly

    %% Dead dependencies — integration code still exists in src/ but the
    %% libraries need porting work before re-enabling.
    %%
    %% {rlimit,   {git, "https://github.com/jlouis/rlimit.git",          {branch, "master"}}},  %% rate limiter; stubbed in etorrent_rlimit.erl (see #35)
    %% {azdht,    {git, "https://github.com/arcusfelis/azdht.git",       {branch, "master"}}},  %% Azureus DHT; etorrent_azdht_tracker.erl (see #36)
    %% {mdns,     {git, "https://github.com/jlouis/mdns.git",            {branch, "master"}}},  %% mDNS discovery; etorrent_mdns_*.erl (see #37)
    %% {upnp,     {git, "https://github.com/jlouis/upnp.git",            {branch, "master"}}},  %% UPnP port mapping; etorrent_upnp_sup.erl (see #38)
]}.
